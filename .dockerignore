# Everything that must not reach the image: local state, secrets, the web
# app (it deploys to Amplify, not here), and anything regenerable.
.git/
.github/
.venv/
.uv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/

.env
.env.*
!.env.example

apps/web/
node_modules/

# Regenerated by `diligence seed`; the deployed demo seeds itself.
seed/
storage/

private/
docs/
.playwright-mcp/
*.md
!README.md
