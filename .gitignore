# python
__pycache__/
*.py[cod]
.venv/
.uv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# node
node_modules/
*.tsbuildinfo
.next/
out/
.turbo/

# env — the production and staging files are the ones most likely to
# hold live credentials, and `.env.*.local` does not cover them.
.env
.env.*
!.env.example

# generated seed feeds (regenerated by seedgen)
seed/**
!seed/.gitkeep

# local object store
storage/

# os
Thumbs.db
.DS_Store

# browser-automation scratch from development
.playwright-mcp/
shot-*.png

# Working artefacts, not part of the public repository. The AWS runbook and
# the engineering notes narrate one account's deploy and carry its live
# credentials; the testing workflows carry the same; the writeup and the video
# script are submission material rather than documentation; and the product
# explainer duplicates the README for a different audience.
private/
