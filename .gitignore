# env — the production and staging files are the ones most likely to
# hold live credentials, and `.env.*.local` does not cover them.
.env
.env.*
!.env.example

# generated seed feeds (regenerated by seedgen)
seed/**
!seed/.gitkeep

# local object store
storage/

# os
Thumbs.db
.DS_Store

# browser-automation scratch from development
.playwright-mcp/
shot-*.png

# Hackathon working artefacts. Not part of the public repository: the AWS
# runbook narrates one account's deploy, the writeup and video script are
# submission material for the form rather than documentation, and the
# product explainer duplicates the README for a different audience.
private/
