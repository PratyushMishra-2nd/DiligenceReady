# Copy to .env. Nothing here is secret; the deployed stack sets all of it
# from CloudFormation and reads the database password from Secrets Manager.

# ── database ────────────────────────────────────────────────────────────────
#
# Local: docker-compose maps 5432 -> 5544 to avoid clashing with a local
# Postgres install.
DATABASE_URL=postgresql+psycopg://diligence:diligence@localhost:5544/diligence

# Deployed, DATABASE_URL is unset and these are used instead. The password
# never appears as configuration: DB_SECRET_ARN points at the Secrets Manager
# secret RDS created and rotates, and the app reads it once at startup.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=diligence
# DB_USER=diligence
# DB_SECRET_ARN=

# ── object store ────────────────────────────────────────────────────────────
#
# Local disk in development, S3 in deployment. Same interface either way:
# documents are content-addressed by sha256, so the key is identical in both
# and a row written against one resolves against the other.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_PREFIX=documents

# ── the model ───────────────────────────────────────────────────────────────
#
# Amazon Bedrock, and nothing else. Leave BEDROCK_MODEL_ID empty and every
# explanation falls back to the deterministic template, which is correct and
# just plainer — the product works with no model at all, which is what makes
# this repository runnable by someone who clones it without an AWS account.
#
# The id is not guessable and differs by region. Ask your account:
#     uv run diligence bedrock models --region ap-south-1
BEDROCK_MODEL_ID=
BEDROCK_REGION=
AWS_REGION=ap-south-1

# ── where the web app reaches the API ───────────────────────────────────────
#
# LOCAL DEVELOPMENT: Leave NEXT_PUBLIC_API_BASE at the default below.
# Browser calls go to localhost:8077. Run uvicorn with `--host ::` (not the
# default). Node resolves `localhost` to ::1 first, so a server on 127.0.0.1
# is unreachable from server components.
#
# DEPLOYED (Amplify): Use the Next.js proxy architecture to avoid HTTPS->HTTP
# mixed-content issues without needing CloudFront or TLS on EC2.
#
#   How it works:
#     Browser -> HTTPS -> Amplify (/api/...) -> Next.js rewrite -> EC2 HTTP
#
#   Required Amplify env vars (set before first build):
#     NEXT_PUBLIC_API_BASE     = ""   (empty string in Amplify console)
#     NEXT_PUBLIC_API_UPSTREAM = http://<ec2-public-dns>:8080
#
#   NEXT_PUBLIC_API_BASE must be "" in Amplify, NOT the EC2 HTTP URL.
#   Setting it to an HTTP URL would cause the browser to call EC2 directly
#   from an HTTPS page, which browsers block (mixed content error).
#
NEXT_PUBLIC_API_BASE=http://localhost:8077

# Server-side proxy target. Used by next.config.mjs rewrites() to forward
# /api/* requests to the EC2 backend server-side (never browser-side).
# NEXT_PUBLIC_API_UPSTREAM=http://<ec2-public-dns>:8080

# Extra browser origins allowed to call the API directly. Not needed with
# the Next.js proxy architecture. localhost:3000 is always allowed.
# CORS_ORIGINS=
