# Copy to .env. Nothing here is secret; the deployed stack sets all of it
# from CloudFormation and reads the database password from Secrets Manager.

# ── database ────────────────────────────────────────────────────────────────
#
# Local: docker-compose maps 5432 -> 5544 to avoid clashing with a local
# Postgres install.
DATABASE_URL=postgresql+psycopg://diligence:diligence@localhost:5544/diligence

# Deployed, DATABASE_URL is unset and these are used instead. The password
# never appears as configuration: DB_SECRET_ARN points at the Secrets Manager
# secret RDS created and rotates, and the app reads it once at startup.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=diligence
# DB_USER=diligence
# DB_SECRET_ARN=

# ── object store ────────────────────────────────────────────────────────────
#
# Local disk in development, S3 in deployment. Same interface either way:
# documents are content-addressed by sha256, so the key is identical in both
# and a row written against one resolves against the other.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_PREFIX=documents

# ── the model ───────────────────────────────────────────────────────────────
#
# Amazon Bedrock, and nothing else. Leave BEDROCK_MODEL_ID empty and every
# explanation falls back to the deterministic template, which is correct and
# just plainer — the product works with no model at all, which is what makes
# this repository runnable by someone who clones it without an AWS account.
#
# The id is not guessable and differs by region. Ask your account:
#     uv run diligence bedrock models --region ap-south-1
BEDROCK_MODEL_ID=
BEDROCK_REGION=
AWS_REGION=ap-south-1

# ── where the web app reaches the API ───────────────────────────────────────
#
# Two things to know, and both have cost an afternoon before.
#
# 1. Read at BUILD time by Next, not at runtime. Set it before
#    `npm run build`, not after. In Amplify that means setting it in the
#    console's environment variables before the first build.
#
# 2. Use the SAME HOST the dashboard is served from. The session is an
#    httpOnly cookie the API sets on its own host; cookies ignore the port
#    but not the host, so an API on 127.0.0.1 and a dashboard on localhost
#    are two different jars and sign-in loops forever.
#
# And a matching trap on the server side: run uvicorn with `--host ::`, not
# the default. Node resolves `localhost` to ::1 first and undici does not
# fall back to IPv4, so a server on 127.0.0.1 only is reachable from the
# browser and NOT from Next's server components — the browser signs in fine
# and every page then renders "the engine is not answering".
NEXT_PUBLIC_API_BASE=http://localhost:8077

# Extra browser origins allowed to call the API, comma separated. The
# deployment puts its Amplify URL here. localhost:3000 is always allowed.
# CORS_ORIGINS=
