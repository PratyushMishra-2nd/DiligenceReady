# Postgres (docker-compose maps 5432 -> 5544 to avoid clashing with a local install)
DATABASE_URL=postgresql+psycopg://diligence:diligence@localhost:5544/diligence

# Object store. Local disk in dev; S3 in deployment. Same interface either way.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# Where the web app reaches the API.
#
# Must be the SAME HOST the dashboard is served from — the session cookie is
# set on the API's host and ignores the port, so mixing localhost and
# 127.0.0.1 silently breaks sign-in. Read at BUILD time by Next, so set it
# before `npm run build`, not after.
NEXT_PUBLIC_API_BASE=http://localhost:8077

# Model is used for extraction + explanation ONLY. It never produces a number.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
